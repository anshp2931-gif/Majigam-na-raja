{
  "name": "majigam-na-raja-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for MAJIGAM NA RAJA Digital ID and Management System",
  "scripts": {
    "dev": "node dev-server.js",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply majigam-na-raja-db --local",
    "migrate:remote": "wrangler d1 migrations apply majigam-na-raja-db --remote",
    "sync:mongo": "node scripts/sync-d1-to-mongo.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.5.0",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "wrangler": "^3.72.0"
  }
}
